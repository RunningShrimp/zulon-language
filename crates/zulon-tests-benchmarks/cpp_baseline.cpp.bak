//! C++ baseline benchmarks for ZULON performance comparison

#include <iostream>
#include <vector>
#include <chrono>
#include <numeric>

/// Simple benchmark result structure
struct BenchmarkResult {
    std::string name;
    size_t iterations;
    double total_duration_ms;
    double avg_duration_ms;
    double min_duration_ms;
    double max_duration_ms;
    double ops_per_sec;
};

/// Run vector push benchmark
BenchmarkResult benchmark_vector_push() {
    BenchmarkResult result;
    result.name = "Vector Push";
    
    size_t iterations = 100000;
    auto start = std::chrono::high_resolution_clock::now();
    
    // Warmup
    for (size_t i = 0; i < 10; ++i) {
        std::vector<int> vec;
    }
    
    // Measurement
    std::vector<double> durations;
    durations.reserve(iterations);
    for (size_t i = 0; i < iterations; ++i) {
        auto t_start = std::chrono::high_resolution_clock::now();
        vec.push_back(i);
        vec.pop_back();
        auto t_end = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration<double, std::milli>(t_end - t_start).count();
        durations.push_back(duration);
    }
    
    result.iterations = iterations;
    result.total_duration_ms = std::accumulate(durations.begin(), durations.end(), 0.0) / durations.size();
    result.avg_duration_ms = result.total_duration_ms / iterations;
    result.min_duration_ms = *std::min_element(durations.begin(), durations.end());
    result.max_duration_ms = *std::max_element(durations.begin(), durations.end());
    result.ops_per_sec = (iterations * 1000.0) / result.total_duration_ms;
    
    return result;
}
    
    // Measurement
    std::vector<double> durations;
    for (size_t i = 0; i < iterations; ++i) {
        auto t_start = std::chrono::high_resolution_clock::now();
        vec.push_back(i);
        vec.pop_back();
        auto t_end = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration<double, std::milli>(t_end - t_start).count();
        durations.push_back(duration);
    }
    
    result.iterations = iterations;
    result.total_duration_ms = std::accumulate(durations.begin(), durations.end(), 0.0) / durations.size();
    result.avg_duration_ms = result.total_duration_ms / iterations;
    result.min_duration_ms = *std::min_element(durations.begin(), durations.end());
    result.max_duration_ms = *std::max_element(durations.begin(), durations.end());
    result.ops_per_sec = (iterations * 1000.0) / result.total_duration_ms;
    
    return result;
}

/// Run hashmap insert benchmark
BenchmarkResult benchmark_hashmap_insert() {
    BenchmarkResult result;
    result.name = "HashMap Insert";
    
    size_t iterations = 100000;
    auto start = std::chrono::high_resolution_clock::now();
    
    // Warmup
    for (size_t i = 0; i < 10; ++i) {
        std::unordered_map<int, int> map;
        for (int j = 0; j < 100; ++j) {
            map.emplace(j, j * 2);
        }
    }
    
    // Measurement
    std::vector<double> durations;
    for (size_t i = 0; i < iterations; ++i) {
        std::unordered_map<int, int> map;
        auto t_start = std::chrono::high_resolution_clock::now();
        for (int j = 0; j < 100; ++j) {
            map.emplace(j, j * 2);
        }
        auto t_end = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration<double, std::milli>(t_end - t_start).count();
        durations.push_back(duration);
    }
    
    result.iterations = iterations;
    result.total_duration_ms = std::accumulate(durations.begin(), durations.end(), 0.0) / durations.size();
    result.avg_duration_ms = result.total_duration_ms / iterations;
    result.min_duration_ms = *std::min_element(durations.begin(), durations.end());
    result.max_duration_ms = *std::max_element(durations.begin(), durations.end());
    result.ops_per_sec = (iterations * 100.0) / result.total_duration_ms;
    
    return result;
}

/// Run string concatenation benchmark
BenchmarkResult benchmark_string_concat() {
    BenchmarkResult result;
    result.name = "String Concat";
    
    size_t iterations = 100000;
    auto start = std::chrono::high_resolution_clock::now();
    
    // Warmup
    std::string base = "Hello, ";
    for (size_t i = 0; i < 100; ++i) {
        std::string s = base + std::to_string(i);
    }
    
    // Measurement
    for (size_t i = 0; i < iterations; ++i) {
        std::string s = base + std::to_string(i);
        (void)s;  // Suppress unused warning
        auto start_time = std::chrono::high_resolution_clock::now();
        std::ignore(s);
        auto end_time = std::chrono::high_resolution_clock::now();
        auto duration = std::chrono::duration<double, std::milli>(end_time - start_time).count();
        durations.push_back(duration);
    }
    
    result.iterations = iterations;
    result.total_duration_ms = std::accumulate(durations.begin(), durations.end(), 0.0) / durations.size();
    result.avg_duration_ms = result.total_duration_ms / iterations;
    result.min_duration_ms = *std::min_element(durations.begin(), durations.end());
    result.max_duration_ms = *std::max_element(durations.begin(), durations.end());
    result.ops_per_sec = (iterations * 1000.0) / result.total_duration_ms;
    
    return result;
}

int main() {
    std::cout << "=== C++ Baseline Benchmarks ===" << std::endl;
    
    auto vec_result = benchmark_vector_push();
    std::cout << vec_result.name << std::endl;
    std::cout << "Iterations: " << vec_result.iterations << std::endl;
    std::cout << "Total time: " << vec_result.total_duration_ms << " ms" << std::endl;
    std::cout << "Average time: " << vec_result.avg_duration_ms << " ms" << std::endl;
    std::cout << "Ops/sec: " << vec_result.ops_per_sec << std::endl;
    std::cout << std::endl;
    
    auto hashmap_result = benchmark_hashmap_insert();
    std::cout << hashmap_result.name << std::endl;
    std::cout << "Iterations: " << hashmap_result.iterations << std::endl;
    std::cout << "Total time: " << hashmap_result.total_duration_ms << " ms" << std::endl;
    std::cout << "Average time: " << hashmap_result.avg_duration_ms << " ms" << std::endl;
    std::cout << "Ops/sec: " << hashmap_result.ops_per_sec << std::endl;
    std::cout << std::endl;
    
    auto string_result = benchmark_string_concat();
    std::cout << string_result.name << std::endl;
    std::cout << "Iterations: " << string_result.iterations << std::endl;
    std::cout << "Total time: " << string_result.total_duration_ms << " ms" << std::endl;
    std::cout << "Average time: " << string_result.avg_duration_ms << " ms" << std::endl;
    std::cout << "Ops/sec: " << string_result.ops_per_sec << std::endl;
    std::cout << std::endl;
    
    return 0;
}
